LINKFILE_APP_ENV=development
LINKFILE_PUBLIC_BASE_URL=http://localhost:8000
LINKFILE_DATABASE_URL=sqlite:///./linkfile.db
LINKFILE_JWT_SECRET=change-me
LINKFILE_JWT_ALGORITHM=HS256
